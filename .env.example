# ZzhClaw 配置
OPENAI_MODEL_ID=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here

# LLM 调用重试与超时（可选，默认 3 次 / 60 秒）
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# 请求 usage（默认 true；不支持此参数的兼容服务可设为 false，token 显示 N/A）
OPENAI_STREAM_USAGE=true

# 可选：每百万输入/输出 token 单价，必须成对配置；不配置则费用为 N/A。
# 请填你实际使用的服务及模型单价；以下数值仅为格式示例。
# OPENAI_INPUT_PRICE_PER_MILLION=1.0
# OPENAI_OUTPUT_PRICE_PER_MILLION=2.0
# OPENAI_PRICE_CURRENCY=USD
